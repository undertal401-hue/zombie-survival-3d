[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="zombie"
3d_physics/layer_3="bullet"
3d_physics/layer_4="environment"
3d_physics/layer_5="pickup"
3d_physics/layer_6="hitbox"
3d_physics/layer_7="safezone"
3d_physics/layer_8="enemy_projectile"

[physics]

3d/default_linear_damp=0.05
3d/max_sub_steps=8
3d/default_cell_size=2.0

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
quality/shadow_atlas/size=2048
quality/shadows/filter_mode=2
